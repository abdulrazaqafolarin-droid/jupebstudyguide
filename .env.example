VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_ADMIN_EMAIL="your-admin-email@example.com"

# Optional local-only API credentials for question answering and source extraction.
# Store real values in a local .env file only; never commit them.
GEMINI_API_KEY="your-gemini-api-key"
# Or use a comma-separated list:
# GEMINI_API_KEYS="key-one,key-two"
LLAMA_PARSE_API_KEY="your-llamaparse-api-key"
